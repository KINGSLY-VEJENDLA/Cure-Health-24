<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Conditions & Diseases | Cure Health 24</title>
        <link rel="icon" type="image/png" href="/images/logo/favicon.png">


    <meta
        name="description"
        content="Explore health conditions, symptoms, treatment information and general healthcare resources from Cure Health 24."
    >
<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/health-conditions.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link rel="stylesheet" href="/css/hero.css">
</head>

<body>

    <%- include('../partials/navbar') %>

    <main>

        <!-- HERO -->

        <section class="conditions-hero">

            <div class="section-container">

                <div class="conditions-hero-content">

                    <span class="section-label hero-label">
                        Health Library
                    </span>

                    <h1>
                        Conditions &
                        <span>Diseases</span>
                    </h1>

                    <p>
                        Explore trusted general information about
                        common health conditions, symptoms, prevention
                        and available treatment options.
                    </p>

                </div>

            </div>

        </section>


        <!-- CONDITIONS -->

        <section class="conditions-section">

            <div class="section-container">

                <div class="section-heading">

                    <span class="section-label">
                        Browse Conditions
                    </span>

                    <h2>
                        Find Information About Your Health
                    </h2>

                    <p>
                        Select a condition to learn more about its
                        common symptoms, risk factors and general care.
                    </p>

                </div>


                <div class="conditions-grid">


                    <!-- Diabetes -->

                    <a
                        href="/health-library/conditions/diabetes"
                        class="condition-card"
                    >

                        <div class="condition-icon">
                            <img
                                src="/images/services/icons9.png"
                                alt="Diabetes icon"
                            >
                        </div>

                        <div>

                            <h3>
                                Diabetes
                            </h3>

                            <p>
                                Learn about diabetes, symptoms,
                                risk factors and management.
                            </p>

                        </div>

                        <span>→</span>

                    </a>


                    <!-- Hypertension -->

                    <a
                        href="/health-library/conditions/hypertension"
                        class="condition-card"
                    >

                        <div class="condition-icon">
                            <img
                                src="/images/services/icons7.png"
                                alt="High Blood Pressure icon"
                            >
                        </div>

                        <div>

                            <h3>
                                High Blood Pressure
                            </h3>

                            <p>
                                Understand hypertension and the
                                importance of regular monitoring.
                            </p>

                        </div>

                        <span>→</span>

                    </a>


                    <!-- Heart Disease -->

                    <a
                        href="/health-library/conditions/heart-health"
                        class="condition-card"
                    >

                        <div class="condition-icon">
                            <img
                                src="/images/services/icons1.png"
                                alt="Heart Disease icon"
                            >
                        </div>

                        <div>

                            <h3>
                                Heart Disease
                            </h3>

                            <p>
                                General information about heart
                                health and cardiovascular conditions.
                            </p>

                        </div>

                        <span>→</span>

                    </a>


                    <!-- Asthma -->

                    <a
                        href="/health-library/conditions/asthma"
                        class="condition-card"
                    >

                        <div class="condition-icon">
                            <img
                                src="/images/services/icons3.png"
                                alt="Asthma icon"
                            >
                        </div>

                        <div>

                            <h3>
                                Asthma
                            </h3>

                            <p>
                                Learn about asthma symptoms,
                                triggers and general management.
                            </p>

                        </div>

                        <span>→</span>

                    </a>


                    <!-- Arthritis -->

                    <a
                        href="/health-library/conditions/arthritis"
                        class="condition-card"
                    >

                        <div class="condition-icon">
                            <img
                                src="/images/services/icons6.png"
                                alt="Arthritis icon"
                            >
                        </div>

                        <div>

                            <h3>
                                Arthritis
                            </h3>

                            <p>
                                Understand joint pain, inflammation
                                and common types of arthritis.
                            </p>

                        </div>

                        <span>→</span>

                    </a>


                    <!-- Migraine -->

                    <a
                        href="/health-library/conditions/migraine"
                        class="condition-card"
                    >

                        <div class="condition-icon">
                            <img
                                src="/images/services/icons4.png"
                                alt="Migraine icon"
                            >
                        </div>

                        <div>

                            <h3>
                                Migraine
                            </h3>

                            <p>
                                Learn about migraine symptoms,
                                triggers and available care.
                            </p>

                        </div>

                        <span>→</span>

                    </a>


                </div>

            </div>

        </section>


        <!-- DISCLAIMER -->

        <section class="medical-disclaimer">

            <div class="section-container">

                <div class="disclaimer-box">

                    <strong>
                        Medical Disclaimer
                    </strong>

                    <p>
                        The information provided in the Health Library
                        is for general educational purposes only. It is
                        not a substitute for professional medical advice,
                        diagnosis or treatment. Please consult a qualified
                        healthcare professional regarding your individual
                        health concerns.
                    </p>

                </div>

            </div>

        </section>


        <!-- CTA -->

        <section class="conditions-cta">

            <div class="section-container">

                <div class="conditions-cta-box">

                    <div>

                        <span class="section-label">
                            Need Medical Care?
                        </span>

                        <h2>
                            Find the Right Doctor for You
                        </h2>

                        <p>
                            Connect with a healthcare professional
                            based on your medical needs.
                        </p>

                    </div>

                    <!-- <a
                        href="/find-doctor"
                        class="conditions-cta-button"
                    >
                        Find a Doctor →
                    </a> -->

                </div>

            </div>

        </section>

    </main>

    <%- include('../partials/footer') %>
    <script src="/js/navbar.js"></script>

</body>

</html>
        <!-- =================================
             SERVICES HERO
        ================================== -->

        <section class="services-hero">

            <div class="services-hero-container">

                <div class="services-hero-content">

                    <span class="section-label hero-label">
                        Medical Services
                    </span>

                    <h1>
                        Comprehensive Care
                        <span>For Every Need.</span>
                    </h1>

                    <p>
                        Explore healthcare specialties and services
                        designed to support your health at every stage
                        of your journey.
                    </p>

                    <div class="services-hero-buttons">

                        <!-- <a href="/"
                           class="service-btn primary">
                            Find a Doctor
                        </a> -->

                        <a href="/appointment"
                           class="service-btn secondary">
                            Book Appointment
                        </a>

                    </div>

                </div>


                <div class="services-hero-image">

                    <img
                        src="/images/services/service.png"
                        alt="Medical healthcare services">

                </div>

            </div>

        </section>




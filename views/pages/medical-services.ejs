        <!-- =================================
             FAQ
        ================================== -->

        <section class="services-faq">

            <div class="section-container">

                <div class="section-heading centered">

                    <span class="section-label">
                        Frequently Asked Questions
                    </span>

                    <h2>
                        Common Questions
                    </h2>

                </div>


                <div class="faq-list">


                    <details>

                        <summary>
                            What medical services are available?
                            <span>+</span>
                        </summary>

                        <p>
                            Cure Health 24 provides access to a
                            range of healthcare specialties. Explore
                            our medical services page for the latest
                            available services.
                        </p>

                    </details>


                    <details>

                        <summary>
                            How can I find a doctor?
                            <span>+</span>
                        </summary>

                        <p>
                            Visit our Find a Doctor page to explore
                            healthcare professionals and available
                            specialties.
                        </p>

                    </details>


                    <details>

                        <summary>
                            How can I book an appointment?
                            <span>+</span>
                        </summary>

                        <p>
                            You can use our online appointment form
                            to submit your preferred appointment
                            details.
                        </p>

                    </details>


                    <details>

                        <summary>
                            Where can I find health information?
                            <span>+</span>
                        </summary>

                        <p>
                            Visit our Health Library for information
                            about diseases, conditions and general
                            healthcare topics.
                        </p>

                    </details>

                </div>

            </div>

        </section>




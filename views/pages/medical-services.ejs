                </div>


                <div class="services-grid">


                    <!-- CARDIOLOGY -->

                    <a href="/medical-services/cardiology"
                       class="service-card">

                        <div class="service-icon">
                            <img
                                src="/images/services/icons1.png"
                                alt="Cardiology icon">
                        </div>

                        <div class="service-card-content">

                            <h3>
                                Cardiology
                            </h3>

                            <p>
                                Heart health, diagnosis and
                                cardiovascular care.
                            </p>

                        </div>

                        <span class="service-arrow">
                            →
                        </span>

                    </a>


                    <!-- DENTISTRY -->

                    <a href="/medical-services/dentistry"
                       class="service-card">

                        <div class="service-icon">
                            <img
                                src="/images/services/icons2.png"
                                alt="Dentistry icon">
                        </div>

                        <div class="service-card-content">

                            <h3>
                                Dentistry
                            </h3>

                            <p>
                                Preventive and comprehensive
                                dental care.
                            </p>

                        </div>

                        <span class="service-arrow">
                            →
                        </span>

                    </a>


                    <!-- GASTRO -->

                    <a href="/medical-services/gastroenterology"
                       class="service-card">

                        <div class="service-icon">
                            <img
                                src="/images/services/icons3.png"
                                alt="Gastroenterology icon">
                        </div>

                        <div class="service-card-content">

                            <h3>
                                Gastroenterology
                            </h3>

                            <p>
                                Diagnosis and treatment of
                                digestive health conditions.
                            </p>

                        </div>

                        <span class="service-arrow">
                            →
                        </span>

                    </a>


                    <!-- NEURO -->

                    <a href="/medical-services/neurology"
                       class="service-card">

                        <div class="service-icon">
                            <img
                                src="/images/services/icons4.png"
                                alt="Neurology icon">
                        </div>

                        <div class="service-card-content">

                            <h3>
                                Neurology
                            </h3>

                            <p>
                                Care for neurological and
                                nervous system conditions.
                            </p>

                        </div>

                        <span class="service-arrow">
                            →
                        </span>

                    </a>


                    <!-- ORTHOPEDICS -->

                    <a href="/medical-services/orthopedics"
                       class="service-card">

                        <div class="service-icon">
                            <img
                                src="/images/services/icons5.png"
                                alt="Orthopedics icon">
                        </div>

                        <div class="service-card-content">

                            <h3>
                                Orthopedics
                            </h3>

                            <p>
                                Bone, joint and musculoskeletal
                                healthcare.
                            </p>

                        </div>

                        <span class="service-arrow">
                            →
                        </span>

                    </a>


                    <!-- PEDIATRICS -->

                    <a href="/medical-services/pediatrics"
                       class="service-card">

                        <div class="service-icon">
                            <img
                                src="/images/services/icons6.png"
                                alt="Pediatrics icon">
                        </div>

                        <div class="service-card-content">

                            <h3>
                                Pediatrics
                            </h3>

                            <p>
                                Healthcare focused on infants,
                                children and adolescents.
                            </p>

                        </div>

                        <span class="service-arrow">
                            →
                        </span>

                    </a>


                    <!-- GYNECOLOGY -->

                    <a href="/medical-services/gynecology"
                       class="service-card">

                        <div class="service-icon">
                            <img
                                src="/images/services/icons7.png"
                                alt="Gynecology icon">
                        </div>

                        <div class="service-card-content">

                            <h3>
                                Gynecology
                            </h3>

                            <p>
                                Comprehensive women's
                                healthcare services.
                            </p>

                        </div>

                        <span class="service-arrow">
                            →
                        </span>

                    </a>


                    <!-- DERMATOLOGY -->

                    <a href="/medical-services/dermatology"
                       class="service-card">

                        <div class="service-icon">
                            <img
                                src="/images/services/icons8.png"
                                alt="Dermatology icon">
                        </div>

                        <div class="service-card-content">

                            <h3>
                                Dermatology
                            </h3>

                            <p>
                                Skin, hair and nail health
                                and treatment.
                            </p>

                        </div>

                        <span class="service-arrow">
                            →
                        </span>

                    </a>


                    <!-- GENERAL MEDICINE -->

                    <a href="/medical-services/general-medicine"
                       class="service-card">

                        <div class="service-icon">
                            <img
                                src="/images/services/icons9.png"
                                alt="General Medicine icon">
                        </div>

                        <div class="service-card-content">

                            <h3>
                                General Medicine
                            </h3>

                            <p>
                                Primary care for everyday
                                healthcare needs.
                            </p>

                        </div>

                        <span class="service-arrow">
                            →
                        </span>

                    </a>


                    <!-- UROLOGY -->

                    <a href="/medical-services/urology"
                       class="service-card">

                        <div class="service-icon">
                            <img
                                src="/images/services/icons10.png"
                                alt="Urology icon">
                        </div>

                        <div class="service-card-content">

                            <h3>
                                Urology
                            </h3>

                            <p>
                                Diagnosis and treatment of
                                urinary and reproductive conditions.
                            </p>

                        </div>

                        <span class="service-arrow">
                            →
                        </span>

                    </a>


                    <!-- ENT -->

                    <a href="/medical-services/ent"
                       class="service-card">

                        <div class="service-icon">
                            <img
                                src="/images/services/icons11.png"
                                alt="ENT icon">
                        </div>

                        <div class="service-card-content">

                            <h3>
                                ENT
                            </h3>

                            <p>
                                Ear, nose and throat healthcare
                                services.
                            </p>

                        </div>

                        <span class="service-arrow">
                            →
                        </span>

                    </a>


                    <!-- RENAL -->

                    <a href="/medical-services/renal-care"
                       class="service-card">

                        <div class="service-icon">
                            <img
                                src="/images/services/icons12.png"

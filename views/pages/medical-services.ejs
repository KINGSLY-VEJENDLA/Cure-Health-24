        <!-- =================================
             FEATURED SERVICE
        ================================== -->

        <section class="featured-service">

            <div class="section-container">

                <div class="featured-service-box">

                    <div class="featured-image">

                        <img
                            src="/images/services/healthcare_image.png"
                            alt="Personalized healthcare">

                    </div>


                    <div class="featured-content">

                        <span class="section-label">
                            Patient-Centered Care
                        </span>

                        <h2>
                            Healthcare That Starts
                            With You
                        </h2>

                        <p>
                            Every healthcare journey is different.
                            Our goal is to make finding healthcare
                            services and information easier and more
                            convenient for you.
                        </p>


                        <ul>

                            <li>
                                <span>✓</span>
                                Convenient access to healthcare resources
                            </li>

                            <li>
                                <span>✓</span>
                                Multiple medical specialties
                            </li>

                            <li>
                                <span>✓</span>
                                Patient-focused experience
                            </li>

                            <li>
                                <span>✓</span>
                                Easy appointment access
                            </li>

                        </ul>


                        <a href="/appointment"
                           class="service-btn primary">
                            Book an Appointment
                        </a>


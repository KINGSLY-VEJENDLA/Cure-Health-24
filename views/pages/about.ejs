<!DOCTYPE html>
<html lang="en">
<head>

    <!-- =========================================
         BASIC SEO
    ========================================== -->

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>About Cure Health 24 | Our Healthcare Mission</title>

<meta
    name="description"
    content="Learn about Cure Health 24, our healthcare approach, specialist services and commitment to accessible and reliable healthcare."
>

    <meta
        name="author"
        content="Cure Health 24"
    >

    <meta
        name="robots"
        content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    >

    <meta
        name="googlebot"
        content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    >


    <!-- =========================================
         CANONICAL
    ========================================== -->

    <link
        rel="canonical"
        href="https://curehealth24.com/"
    >


    <!-- =========================================
         FAVICON
    ========================================== -->

    <link
        rel="icon"
        type="image/png"
        href="/images/logo/favicon.png"
    >

    <link
        rel="apple-touch-icon"
        href="/images/logo/favicon.png"
    >


    <!-- =========================================
         THEME / BRAND
    ========================================== -->

    <meta
        name="theme-color"
        content="#075763"
    >

    <meta
        name="application-name"
        content="Cure Health 24"
    >


    <!-- =========================================
         OPEN GRAPH - FACEBOOK / LINKEDIN
    ========================================== -->

    <meta
        property="og:type"
        content="website"
    >

    <meta
        property="og:title"
        content="Cure Health 24 | Healthcare Services, Doctors & Telemedicine"
    >

    <meta
        property="og:description"
        content="Access healthcare services, specialist consultations, doctors, telemedicine and trusted health information with Cure Health 24."
    >

    <meta
        property="og:url"
        content="https://curehealth24.com/"
    >

    <meta
        property="og:site_name"
        content="Cure Health 24"
    >

    <meta
        property="og:locale"
        content="en_IN"
    >

    <meta
        property="og:image"
        content="https://curehealth24.com/images/og-image.jpg"
    >

    <meta
        property="og:image:width"
        content="1200"
    >

    <meta
        property="og:image:height"
        content="630"
    >

    <meta
        property="og:image:alt"
        content="Cure Health 24 Healthcare Services"
    >


    <!-- =========================================
         TWITTER / X
    ========================================== -->

    <meta
        name="twitter:card"
        content="summary_large_image"
    >

    <meta
        name="twitter:title"
        content="Cure Health 24 | Healthcare Services & Telemedicine"
    >

    <meta
        name="twitter:description"
        content="Cure Health 24 connects people with healthcare services, doctors, specialist consultations, telemedicine and trusted health information."
    >

    <meta
        name="twitter:image"
        content="https://curehealth24.com/images/og-image.jpg"
    >

    <meta
        name="twitter:image:alt"
        content="Cure Health 24 Healthcare Services"
    >


    <!-- =========================================
         PERFORMANCE
    ========================================== -->

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >


    <!-- =========================================
         FONT AWESOME
    ========================================== -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >


    <!-- =========================================
         WEBSITE CSS
    ========================================== -->

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/hero.css">
    <link rel="stylesheet" href="/css/responsive.css">
    <link rel="stylesheet" href="/css/specialities.css">
    <link rel="stylesheet" href="/css/conditions.css">
    <link rel="stylesheet" href="/css/testimonials.css">
    <link rel="stylesheet" href="/css/partners.css">
    <link rel="stylesheet" href="/css/cta.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/appointment.css">
    <link rel="stylesheet" href="/css/health-library.css">
    <link rel="stylesheet" href="/css/doctors.css">
    <link rel="stylesheet" href="/css/services.css">
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/why.css">
    <link rel="stylesheet" href="/css/contact.css">
    <link rel="stylesheet" href="/css/about.css">


    <!-- =========================================
         STRUCTURED DATA
         ORGANIZATION / HEALTHCARE
    ========================================== -->

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "MedicalOrganization",

        "@id": "https://curehealth24.com/#organization",

        "name": "Cure Health 24",

        "url": "https://curehealth24.com/",

        "logo": {
            "@type": "ImageObject",
            "url": "https://curehealth24.com/images/logo/logo.png"
        },

        "description": "Cure Health 24 provides healthcare services, specialist consultations, doctors, telemedicine and health information.",

        "email": "info@curehealth24.com",

        "telephone": "+91-9849466959",

        "sameAs": []
    }
    </script>


    <!-- =========================================
         WEBSITE SCHEMA
    ========================================== -->

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",

        "@type": "WebSite",

        "@id": "https://curehealth24.com/#website",

        "url": "https://curehealth24.com/",

        "name": "Cure Health 24",

        "description": "Healthcare services, doctors, specialist consultations, telemedicine and health information.",

        "publisher": {
            "@id": "https://curehealth24.com/#organization"
        }
    }
    </script>

</head>

<body>

    <%- include('../partials/navbar') %>

    <main>

        <!-- =========================
             ABOUT HERO
        ========================== -->

        <section class="about-hero">

            <div class="about-hero-container">

                <div class="about-hero-content">

                    <span class="section-label hero-label">
                        About Cure Health 24
                    </span>

                    <h1>
                        Healthcare Designed
                        <span>Around You.</span>
                    </h1>

                    <p>
                        At Cure Health 24, we believe healthcare should
                        be accessible, convenient and focused on the
                        needs of every individual.
                    </p>

                    <a href="/contact"
                       class="about-btn">
                        Get in Touch
                    </a>

                </div>


                <div class="about-hero-image">

                    <img
                        src="/images/about/ABOUT1.png"
                        alt="Cure Health 24 healthcare">

                </div>

            </div>

        </section>


        <!-- =========================
             WHO WE ARE
        ========================== -->

        <section class="who-we-are">

            <div class="about-container">

                <div class="who-image">

                    <img
                        src="/images/about/Abt.png"
                        alt="Healthcare professionals">

                </div>


                <div class="who-content">

                    <span class="section-label">
                        Who We Are
                    </span>

                    <h2>
                        Making Healthcare
                        Easier to Access
                    </h2>

                    <p>
                        Cure Health 24 is focused on creating a
                        healthcare experience that connects people
                        with the information, services and medical
                        support they need.
                    </p>

                    <p>
                        We aim to make healthcare more convenient
                        by bringing essential healthcare resources
                        together in one accessible platform.
                    </p>


                    <div class="who-points">

                        <div>
                            <span>✓</span>
                            <strong>Patient-focused approach</strong>
                        </div>

                        <div>
                            <span>✓</span>
                            <strong>Accessible healthcare information</strong>
                        </div>

                        <div>
                            <span>✓</span>
                            <strong>Convenient healthcare services</strong>
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             MISSION / VISION
        ========================== -->

        <section class="mission-vision">

            <div class="about-container">

                <div class="section-heading centered">

                    <span class="section-label">
                        Our Purpose
                    </span>

                    <h2>
                        Our Mission & Vision
                    </h2>

                </div>


                <div class="mission-grid">

                    <div class="mission-card">

                        <div class="mission-icon">
                            <img
                                src="/images/services/mission.png"
                                alt="Mission icon">
                        </div>

                        <h3>
                            Our Mission
                        </h3>

                        <p>
                            To make quality healthcare services and
                            useful health information easier to access,
                            helping people make informed decisions
                            about their healthcare.
                        </p>

                    </div>


                    <div class="mission-card vision-card">

                        <div class="mission-icon">
                            <img
                                src="/images/services/vis.png"
                                alt="Vision icon">
                        </div>

                        <h3>
                            Our Vision
                        </h3>

                        <p>
                            To build a trusted healthcare platform
                            where people can conveniently discover
                            healthcare services, professionals and
                            reliable health resources.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             OUR VALUES
        ========================== -->

        <section class="values">

            <div class="about-container">

                <div class="section-heading">

                    <span class="section-label">
                        Our Values
                    </span>

                    <h2>
                        What We Stand For
                    </h2>

                    <p>
                        Our values guide the way we build healthcare
                        experiences for patients and communities.
                    </p>

                </div>


                <div class="values-grid">

                    <div class="value-card">

                        <div class="value-number">
                            01
                        </div>

                        <h3>
                            Patient First
                        </h3>

                        <p>
                            We keep the needs and experience of
                            patients at the center of everything
                            we do.
                        </p>

                    </div>


                    <div class="value-card">

                        <div class="value-number">
                            02
                        </div>

                        <h3>
                            Trust
                        </h3>

                        <p>
                            We believe healthcare should be built
                            on transparency, reliability and trust.
                        </p>

                    </div>


                    <div class="value-card">

                        <div class="value-number">
                            03
                        </div>

                        <h3>
                            Accessibility
                        </h3>

                        <p>
                            We work toward making healthcare
                            information and services easier to reach.
                        </p>

                    </div>


                    <div class="value-card">

                        <div class="value-number">
                            04
                        </div>

                        <h3>
                            Innovation
                        </h3>

                        <p>
                            We use technology and modern solutions
                            to create better healthcare experiences.
                        </p>

                    </div>

                </div>

            </div>

        </section>


                <!-- =========================
             CTA
        ========================== -->

        <section class="health-cta">

            <div class="cta-container">

                <div class="cta-content">

                    <span>
                        Cure Health 24
                    </span>

                    <h2>
                        Your Health Matters.
                        We're Here to Help.
                    </h2>

                    <p>
                        Explore our healthcare services or
                        connect with us today.
                    </p>

                </div>


                <div class="cta-actions">

                    <a href="/medical-services"
                       class="cta-button light">
                        Explore Services
                    </a>

                    <a href="/appointment"
                       class="cta-button yellow">
                        Contact Us
                    </a>

                </div>

            </div>

        </section>

        <!-- =========================
             HEALTHCARE APPROACH
        ========================== -->

        <section class="approach">

            <div class="about-container">

                <div class="approach-content">

                    <span class="section-label">
                        Our Approach
                    </span>

                    <h2>
                        A Better Healthcare Experience
                    </h2>

                    <p>
                        Healthcare can sometimes feel complicated.
                        Cure Health 24 aims to simplify the journey
                        by helping people find the right information
                        and healthcare resources.
                    </p>


                    <div class="approach-steps">

                        <div class="approach-step">

                            <span>01</span>

                            <div>
                                <h3>
                                    Discover
                                </h3>

                                <p>
                                    Find healthcare services,
                                    specialties and useful
                                    health information.
                                </p>
                            </div>

                        </div>


                        <div class="approach-step">

                            <span>02</span>

                            <div>
                                <h3>
                                    Connect
                                </h3>

                                <p>
                                    Connect with healthcare
                                    professionals and services.
                                </p>
                            </div>

                        </div>


                        <div class="approach-step">

                            <span>03</span>

                            <div>
                                <h3>
                                    Care
                                </h3>

                                <p>
                                    Take the next step toward
                                    better healthcare.
                                </p>
                            </div>

                        </div>

                    </div>

                </div>


                <div class="approach-image">

                    <img
                        src="/images/about/abt1.jpg"
                        alt="Patient healthcare">

                </div>

            </div>

        </section>



    </main>


    <%- include('../partials/footer') %>

    <script src="/js/navbar.js"></script>
    <script src="/js/main.js"></script>
    

</body>
</html>
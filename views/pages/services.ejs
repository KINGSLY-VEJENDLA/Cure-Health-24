<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Healthcare Services | Cure Health 24</title>
        <link rel="icon" type="image/png" href="/images/logo/favicon.png">


    <meta name="description"
        content="Explore healthcare services from Cure Health 24, providing reliable medical care, health support, preventive care, consultations, and patient-focused healthcare solutions.">

    <meta name="robots" content="index, follow">

    <link rel="canonical" href="https://curehealth24.com/services">


    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/services.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/appointment.css">
    <link rel="stylesheet" href="/css/health-library.css">
    <link rel="stylesheet" href="/css/doctor.css">
    <link rel="stylesheet" href="/css/404.css">
    <link rel="stylesheet" href="/css/terms.css">
    <link rel="stylesheet" href="/css/medical-services.css">
    <link rel="stylesheet" href="/css/about.css">
    <link rel="stylesheet" href="/css/contact.css">
    <link rel="stylesheet" href="/css/services-page.css">
    <link rel="stylesheet" href="/css/hero.css">


    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">
</head>

<body>

    <!-- Navbar -->
    <%- include("../partials/navbar") %>


    <!-- =========================
         SERVICES HERO
    ========================== -->

    <section class="services-hero">

        <div class="services-hero-content">

            <span class="section-tag hero-label">
                Our Healthcare Services
            </span>

            <h1>
                Quality Healthcare Designed Around You
            </h1>

            <p>
                At Cure Health 24, we provide accessible, reliable, and
                patient-focused healthcare services designed to support
                your health and well-being at every stage of life.
            </p>

            <a href="/contact" class="primary-btn">
                Get in Touch
            </a>

        </div>

    </section>


    <!-- =========================
         SERVICES INTRO
    ========================== -->

    <section class="services-intro">

        <div class="container">

            <span class="section-tag">
                Healthcare You Can Trust
            </span>

            <h2>
                Comprehensive Healthcare Services
            </h2>

            <p>
                We believe healthcare should be simple, accessible, and
                centered around the needs of every patient. Our healthcare
                services are designed to provide professional support,
                convenient access, and a better overall healthcare experience.
            </p>

        </div>

    </section>


    <!-- =========================
         SERVICE CARDS
    ========================== -->

    <section class="services-grid-section">

        <div class="container">

            <div class="services-grid">

                <!-- Card 1 -->
                <div class="service-card">

                    <div class="service-icon">
                        <img
                            src="/images/services/ser1.png"
                            alt="Primary Healthcare icon">
                    </div>

                    <h3>
                        Primary Healthcare
                    </h3>

                    <p>
                        Reliable primary healthcare services focused on
                        routine medical needs, health concerns, and
                        personalized patient care.
                    </p>

                    <a href="/contact">
                        Learn More →
                    </a>

                </div>


                <!-- Card 2 -->
                <div class="service-card">

                    <div class="service-icon">
                        <img
                            src="/images/services/ser2.png"
                            alt="Preventive Healthcare icon">
                    </div>

                    <h3>
                        Preventive Healthcare
                    </h3>

                    <p>
                        Support your long-term health with preventive
                        healthcare, regular health assessments, and
                        wellness-focused care.
                    </p>

                    <a href="/contact">
                        Learn More →
                    </a>

                </div>


                <!-- Card 3 -->
                <div class="service-card">

                    <div class="service-icon">
                        <img
                            src="/images/services/ser3.png"
                            alt="Medical Consultation icon">
                    </div>

                    <h3>
                        Medical Consultation
                    </h3>

                    <p>
                        Get professional medical guidance and personalized
                        healthcare support based on your individual needs.
                    </p>

                    <a href="/contact">
                        Learn More →
                    </a>

                </div>


                <!-- Card 4 -->
                <div class="service-card">

                    <div class="service-icon">
                        <img
                            src="/images/services/ser4.png"
                            alt="Specialized Care icon">
                    </div>

                    <h3>
                        Specialized Care
                    </h3>

                    <p>
                        Access healthcare support for a range of medical
                        needs with a focus on quality, safety, and patient
                        satisfaction.
                    </p>

                    <a href="/contact">
                        Learn More →
                    </a>

                </div>


                <!-- Card 5 -->
                <div class="service-card">

                    <div class="service-icon">
                        <img
                            src="/images/services/ser5.png"
                            alt="Health Checkups icon">
                    </div>

                    <h3>
                        Health Checkups
                    </h3>

                    <p>
                        Regular health checkups can help identify potential
                        health concerns early and support better health
                        management.
                    </p>

                    <a href="/contact">
                        Learn More →
                    </a>

                </div>


                <!-- Card 6 -->
                <div class="service-card">

                    <div class="service-icon">
                        <img
                            src="/images/services/ser6.png"
                            alt="Patient Support icon">
                    </div>

                    <h3>
                        Patient Support
                    </h3>

                    <p>
                        We focus on clear communication and dependable
                        patient support to make your healthcare journey
                        easier and more comfortable.
                    </p>

                    <a href="/contact">
                        Learn More →
                    </a>

                </div>

            </div>

        </div>

    </section>


    <!-- =========================
         CTA
    ========================== -->

    <section class="services-cta">

        <div class="container">

            <h2>
                Take the Next Step Toward Better Healthcare
            </h2>

            <p>
                Have questions about our healthcare services?
                Get in touch with Cure Health 24 today.
            </p>

            <a href="/appointment" class="primary-btn">
                Contact Us
            </a>

        </div>

    </section>


    <!-- Footer -->
    <%- include("../partials/footer") %>
    <script src="/js/navbar.js"></script>
    <script src="/js/appointment.js"></script>
    <script src="/js/health-library.js"></script>
    <script src="/js/services.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/doctor.js"></script>

</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Healthcare Services | Cure Health 24</title>

    <link
        rel="icon"
        type="image/png"
        href="/images/logo/favicon.png"
    >

    <meta
        name="description"
        content="Explore healthcare services from Cure Health 24, providing reliable medical care, health support, preventive care, consultations, and patient-focused healthcare solutions."
    >

    <meta
        name="robots"
        content="index, follow"
    >

    <link
        rel="canonical"
        href="https://curehealth24.com/services"
    >

    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

    <!-- Main CSS -->
    <link
        rel="stylesheet"
        href="/css/main.css"
    >

    <!-- Navbar -->
    <link
        rel="stylesheet"
        href="/css/navbar.css"
    >

    <!-- Services -->
    <link
        rel="stylesheet"
        href="/css/services-page.css"
    >

    <!-- Footer -->
    <link
        rel="stylesheet"
        href="/css/footer.css"
    >

    <!-- Hero -->
    <link
        rel="stylesheet"
        href="/css/hero.css"
    >

    <!-- Google Font -->
    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

</head>


<body>


    <!-- =====================================================
         NAVBAR
         ===================================================== -->

    <%- include("../partials/navbar") %>


    <main>


        <!-- =====================================================
             SERVICES HERO
             ===================================================== -->

        <section class="services-hero">

            <div class="services-hero-content">

                <span class="services-section-tag">

                    Our Healthcare Services

                </span>


                <h1>

                    Quality Healthcare
                    <span>Designed Around You</span>

                </h1>


                <p>

                    At Cure Health 24, we provide accessible,
                    reliable, and patient-focused healthcare
                    services designed to support your health
                    and well-being at every stage of life.

                </p>


                <a
                    href="/appointment"
                    class="services-primary-btn"
                >

                    Get in Touch

                </a>

            </div>

        </section>



        <!-- =====================================================
             SERVICES INTRO
             ===================================================== -->

        <section class="services-intro">

            <div class="services-container">

                <div class="services-intro-content">

                    <span class="services-section-tag">

                        Healthcare You Can Trust

                    </span>


                    <h2>

                        Comprehensive Healthcare Services

                    </h2>


                    <p>

                        We believe healthcare should be simple,
                        accessible, and centered around the needs
                        of every patient. Our healthcare services
                        are designed to provide professional support,
                        convenient access, and a better overall
                        healthcare experience.

                    </p>

                </div>

            </div>

        </section>



        <!-- =====================================================
             SERVICES GRID
             ===================================================== -->

        <section class="services-grid-section">

            <div class="services-container">

                <div class="services-grid">


                    <!-- =================================================
                         CARD 1
                         ================================================= -->

                    <div class="service-card">

                        <div class="service-icon">

                            <img
                                src="/images/services/ser1.png"
                                alt="Primary Healthcare"
                            >

                        </div>


                        <h3>

                            Primary Healthcare

                        </h3>


                        <p>

                            Reliable primary healthcare services
                            focused on routine medical needs,
                            health concerns, and personalized
                            patient care.

                        </p>

                    </div>



                    <!-- =================================================
                         CARD 2
                         ================================================= -->

                    <div class="service-card">

                        <div class="service-icon">

                            <img
                                src="/images/services/ser2.png"
                                alt="Preventive Healthcare"
                            >

                        </div>


                        <h3>

                            Preventive Healthcare

                        </h3>


                        <p>

                            Support your long-term health with
                            preventive healthcare, regular health
                            assessments, and wellness-focused care.

                        </p>

                    </div>



                    <!-- =================================================
                         CARD 3
                         ================================================= -->

                    <div class="service-card">

                        <div class="service-icon">

                            <img
                                src="/images/services/ser3.png"
                                alt="Medical Consultation"
                            >

                        </div>


                        <h3>

                            Medical Consultation

                        </h3>


                        <p>

                            Get professional medical guidance and
                            personalized healthcare support based
                            on your individual needs.

                        </p>

                    </div>



                    <!-- =================================================
                         CARD 4
                         ================================================= -->

                    <div class="service-card">

                        <div class="service-icon">

                            <img
                                src="/images/services/ser4.png"
                                alt="Specialized Care"
                            >

                        </div>


                        <h3>

                            Specialized Care

                        </h3>


                        <p>

                            Access healthcare support for a range
                            of medical needs with a focus on quality,
                            safety, and patient satisfaction.

                        </p>

                    </div>



                    <!-- =================================================
                         CARD 5
                         ================================================= -->

                    <div class="service-card">

                        <div class="service-icon">

                            <img
                                src="/images/services/ser5.png"
                                alt="Health Checkups"
                            >

                        </div>


                        <h3>

                            Health Checkups

                        </h3>


                        <p>

                            Regular health checkups can help identify
                            potential health concerns early and
                            support better health management.

                        </p>

                    </div>



                    <!-- =================================================
                         CARD 6
                         ================================================= -->

                    <div class="service-card">

                        <div class="service-icon">

                            <img
                                src="/images/services/ser6.png"
                                alt="Patient Support"
                            >

                        </div>


                        <h3>

                            Patient Support

                        </h3>


                        <p>

                            We focus on clear communication and
                            dependable patient support to make your
                            healthcare journey easier and more
                            comfortable.

                        </p>

                    </div>


                </div>

            </div>

        </section>



        <!-- <!-- =====================================================
             CTA
             ===================================================== -->

        <!-- <section class="services-cta">

            <div class="services-container">

                <div class="services-cta-content">

                    <span class="services-section-tag">

                        Cure Health 24

                    </span>


                    <h2>

                        Healthcare That Works
                        Around Your Needs

                    </h2>


                    <p>

                        Take the next step toward convenient,
                        accessible healthcare.

                    </p>


                    <a
                        href="/appointment"
                        class="services-primary-btn services-cta-btn"
                    >

                        Book an Appointment

                    </a>

                </div>

            </div>

        </section>  -->


    </main>



    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <%- include("../partials/footer") %>



    <!-- =====================================================
         JAVASCRIPT
         ===================================================== -->

    <script src="/js/navbar.js"></script>

    <script src="/js/main.js"></script>

    <script src="/js/services.js"></script>


</body>

</html>